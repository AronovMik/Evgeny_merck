# Скопируйте этот файл в sandbox/.env и подставьте свой ключ.
# sandbox/.env добавлен в .gitignore и в репозиторий не попадёт.

OPENAI_API_KEY=sk-...

# --- всё остальное можно не трогать ---

# Если доступ идёт не напрямую в OpenAI, а через шлюз с совместимым API
# (например, корпоративный прокси Langdock) — укажите его базовый адрес:
# OPENAI_BASE_URL=https://api.langdock.com/openai/v1

# Модель по умолчанию, если в профиле не задана своя
SANDBOX_DEFAULT_MODEL=gpt-5

# Порт локального сервера
SANDBOX_PORT=8765

# Таймаут запроса, секунды
SANDBOX_TIMEOUT=600

# Порог предупреждения о размере промпта (в токенах)
SANDBOX_PROMPT_TOKEN_GUARD=180000

# SANDBOX_MOCK=1 — работать без обращения к API (проверка самой песочницы)
# SANDBOX_MOCK=0
